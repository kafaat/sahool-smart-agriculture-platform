# ==============================================================================
# منصة سهول الزراعية الذكية — نموذج متغيرات البيئة
# انسخ هذا الملف إلى .env واملأ القيم. لا تُودِع ملف .env في Git إطلاقاً.
# ==============================================================================

# --- Core ---
NODE_ENV=development
PORT=3000

# --- Database (MySQL) ---
# مثال: mysql://user:password@host:3306/dbname
DATABASE_URL=mysql://sahool_user:change_me@localhost:3306/sahool_db

# --- Auth / Sessions ---
# سر توقيع الجلسات (JWT). استخدم قيمة عشوائية قوية:  openssl rand -hex 32
JWT_SECRET=

# --- OAuth (Manus SDK) ---
VITE_APP_ID=
OAUTH_SERVER_URL=
# openId لمالك النظام — يُمنح دور admin تلقائياً عند أول تسجيل دخول
OWNER_OPEN_ID=

# --- Built-in Forge storage proxy ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- AI (OpenAI) ---
OPENAI_API_KEY=

# --- Third-party integrations (optional) ---
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
OPENWEATHERMAP_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Docker Compose (used by docker-compose.yml) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=sahool_db
MYSQL_USER=sahool_user
MYSQL_PASSWORD=
VITE_APP_TITLE=منصة سهول الزراعية الذكية
